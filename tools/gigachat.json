      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "csv",
              "jira-csv",
              "youtrack-csv",
              "xlsx"
            ]
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "file"
        ]
      }
