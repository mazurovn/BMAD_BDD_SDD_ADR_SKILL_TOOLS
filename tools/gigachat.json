      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "mazu_add",
      "description": "Add an idea, epic, story, task, requirement, or ADR",
      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "idea",
              "epic",
              "story",
              "task",
              "requirement",
              "adr"
            ]
          },
          "title": {
            "type": "string"
          },
          "points": {
            "type": "integer"
          },
          "parent": {
            "type": "string"
          },
          "acceptance": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "title"
        ]
      }
    },
    {
      "name": "mazu_list",
      "description": "List backlog items",
      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "mazu_move",
      "description": "Move an item to a board column",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "backlog",
              "ready",
              "in-progress",
              "review",
              "done"
            ]
          }
        },
        "required": [
          "id",
          "status"
        ]
      }
    },
    {
      "name": "mazu_log",
      "description": "Log hours spent. Not story points.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "hours"
        ]
      }
    },
    {
