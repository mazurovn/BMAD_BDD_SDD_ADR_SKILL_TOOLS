#!/usr/bin/env python3
import json, sys
from pathlib import Path
DATA = Path("mazu-data")
DATA.mkdir(exist_ok=True)
B = DATA / "backlog.json"
if not B.exists(): B.write_text('{"items":[]}')
def load(): return json.loads(B.read_text())
def save(d): B.write_text(json.dumps(d, indent=2, ensure_ascii=False))
if len(sys.argv)<2: print("dashboard | list | add <title>"); sys.exit(1)
c=sys.argv[1]
if c=="dashboard":
    d=load(); st={}
    for i in d["items"]: st[i["status"]]=st.get(i["status"],0)+1
    print("=== MAZU Dashboard ===")
    for s,c in st.items(): print(f"  {s}: {c}")
    print(f"Total: {len(d['items'])}")
elif c=="list":
    for i in load()["items"]: print(f"#{i['id']} [{i['status']}] {i['title']}")
elif c=="add":
    d=load(); d["items"].append({"id":len(d["items"])+1,"title":" ".join(sys.argv[2:]) or "New","status":"backlog"}); save(d); print("Added")
