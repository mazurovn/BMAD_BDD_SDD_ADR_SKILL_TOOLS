#!/bin/sh
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
NODE="$ROOT/upstream/node/node"
if [ ! -x "$NODE" ]; then
  "$ROOT/upstream/cpython/bin/python3.12" -c 'import lzma, pathlib, sys; dest = pathlib.Path(sys.argv[1]); dest.write_bytes(lzma.open(sys.argv[2], "rb").read()); dest.chmod(0o755)' "$NODE" "$ROOT/upstream/node/node.xz"
fi
exec "$NODE" "$ROOT/upstream/node_modules/bmad-method/tools/installer/bmad-cli.js" "$@"
